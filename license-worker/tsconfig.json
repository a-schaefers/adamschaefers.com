{
  // The license server: Cloudflare's runtime globals (@cloudflare/workers-types), not the
  // browser's DOM. tsc only checks (noEmit); wrangler's esbuild compiles. Its tests and
  // scripts/keygen.ts have their own project (test/tsconfig.json: Node's globals too).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts"]
}
