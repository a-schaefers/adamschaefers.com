// License server for the products in src/products.ts (src/index.ts), at
// licenses.adamschaefers.com: real Stripe, real money (there is no sandbox).
//   make licenses-test   the tests, offline        make licenses   tests, then deploy
// Secrets (wrangler secret put NAME), never in the repo, and no copy kept: a lost or leaked one
// is made again at its source (.claude/rules/cicd.md, Credentials), except a signing key, whose
// public half ships in its app: its backup is the GitHub secret of the same name in the
// production environment, which .github/workflows/signing-key.yml checks and restores:
//   STRIPE_SECRET_KEY      live key (Checkout Sessions write is all it needs)
//   STRIPE_WEBHOOK_SECRET  whsec_... of the webhook endpoint for /v1/stripe/webhook
//   SIGNING_KEY            PKCS #8 PEM from scripts/keygen.ts (live-1): signs Backseat Driver's keys only
//   (each product signs with its own: its `signing` in src/products.js names its secret, e.g.
//   SIGNING_KEY_<PRODUCT>, and its kid var, e.g. SIGNING_KID_<PRODUCT>, set below)
//   RESEND_API_KEY         send-only Resend key
//   TURNSTILE_SECRET       the "adamschaefers store" Turnstile widget
// Rotating a product's signing key: add the old key's public half ({ kid, x, y }) to the var its
// `signing.retired` names (OLD_PUBLIC_KEYS for Backseat Driver), so keys it signed can still be
// looked up and have seats added, and ship the new public key in the product's app beside the old
// one (Backseat Driver's PUBLIC_KEYS); its backup (the GitHub secret) and public half
// (signing-key.yml) change with it.
// /admin, every product's licenses, sits behind the Cloudflare Access application
// "Backseat Driver licenses admin" (the name is only a label).
{
  "name": "adamschaefers-licenses",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Only the Worker's own event logs (no IP addresses in them); no per-request logs, which
  // would keep each caller's IP and the URL with its install id.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "d1_databases": [{ "binding": "DB", "database_name": "adamschaefers-licenses", "database_id": "82cd50be-9537-4e53-8779-452a42299433" }],
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "3002", "simple": { "limit": 20, "period": 60 } }],
  "vars": {
    "SITE_ORIGINS": "https://adamschaefers.com",
    "SIGNING_KID": "live-1",
    "PRICES": { "backseat-driver": { "seat": "price_1UPBKcAwNhq3P64enzC9NrPc", "volume": "price_1UPBL8AwNhq3P64ez3duzOAg" } },
    "STRIPE_DASHBOARD": "https://dashboard.stripe.com/acct_1UOvhbAwNhq3P64e",
    "FROM_EMAIL": "Adam Schaefers <licenses@adamschaefers.com>",
    "ACCESS_TEAM": "adamschaefers.cloudflareaccess.com",
    "ACCESS_AUD": "07db6f0f7517fe393148c3e0276cfa4ca05dd8f6060d62babda0b3bae25ba027",
    "ADMIN_EMAIL": "adam.schaefers@icloud.com",
    "TURNSTILE_HOSTNAMES": "adamschaefers.com"
  },
  "routes": [{ "pattern": "licenses.adamschaefers.com", "custom_domain": true }],
  // Only at licenses.adamschaefers.com: no workers.dev address or per-version preview address,
  // which would skip the zone's rate limit and serve old versions with today's secrets and data.
  "workers_dev": false,
  "preview_urls": false
}
