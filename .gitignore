# Local Worker secrets (wrangler reads .dev.vars for local dev) and caches.
# Real secrets live in each Worker's Cloudflare secrets, never in the repo.
.dev.vars*
.env*
.wrangler/
node_modules/
# What make build writes: CI builds it on every merge and deploys it, so it is never
# committed. build/ is the compiled script and styles and every page; public/ what is served.
/build/
/public/
/*-worker/src/*.gen.ts
# Videos and uploads live in R2 (media.adamschaefers.com, managed at /admin), not git.
*.mp4
*.mov
